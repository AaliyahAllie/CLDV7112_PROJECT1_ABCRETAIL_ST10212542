@model IEnumerable<CLDV7112_PROJECT1_ABCRETAIL_ST10212542.Models.OrderEntity>
@{
    ViewData["Title"] = "My Orders";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold mb-1"><span class="text-gradient">My Order History</span></h1>
        <p class="text-white-50">Review the status of your past orders. Your data is isolated securely using your Customer ID.</p>
    </div>
    <div class="col-md-4 text-md-end">
        <a asp-action="Index" class="btn btn-glass btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Shop
        </a>
    </div>
</div>

<div class="glass-panel p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x display-3 text-muted mb-3 d-block"></i>
            <h5 class="fw-semibold text-white">No Orders Placed Yet</h5>
            <p class="text-white-50 mb-4">You haven't placed any orders with ABC Retail. Explore our live catalog to start shopping!</p>
            <a asp-action="Index" class="btn btn-rainbow">
                <i class="bi bi-cart-fill me-2"></i>Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th style="width: 100px;">Product</th>
                        <th>Product Name</th>
                        <th>Ordered Date</th>
                        <th class="text-end">Price</th>
                        <th class="text-center" style="width: 150px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var statusBadge = order.Status == "Pending" ? "bg-warning text-dark" : "bg-success";
                        <tr>
                            <td>
                                <div class="rounded border border-secondary overflow-hidden bg-dark d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                    @if (!string.IsNullOrEmpty(order.ImageUrl))
                                    {
                                        <img src="@order.ImageUrl" alt="@order.ProductName" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-box-seam text-muted fs-4"></i>
                                    }
                                </div>
                            </td>
                            <td>
                                <strong class="text-white">@order.ProductName</strong>
                                <span class="d-block text-white-50 small">Order ID: @order.RowKey</span>
                            </td>
                            <td>
                                <span class="text-white-80">@order.OrderDate.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </td>
                            <td class="text-end fw-bold text-price">
                                @order.ProductPrice.ToString("C")
                            </td>
                            <td class="text-center">
                                <span class="badge @statusBadge">@order.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
