@model IEnumerable<CLDV7112_PROJECT1_ABCRETAIL_ST10212542.Models.Product>
@{
    ViewData["Title"] = "Shop Catalog";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="display-6 fw-bold mb-1"><span class="text-gradient">Product Catalog</span></h1>
        <p class="text-white-50">Browse our seasonal inventory and place your order asynchronously using Azure Storage Queues.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="glass-panel p-5 text-center mt-4">
        <i class="bi bi-box-seam display-3 text-muted mb-3"></i>
        <h4 class="fw-semibold text-white">No Products Available</h4>
        <p class="text-white-50 mb-0">Our inventory is currently empty. Ask the Administrator to log in and upload products with images!</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="glass-panel product-card glass-panel-hover">
                    <div class="product-img-wrapper">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" class="product-img" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 bg-secondary text-white">
                                <i class="bi bi-box-seam fs-1"></i>
                            </div>
                        }
                        <span class="product-category-badge">@product.Category</span>
                    </div>
                    <div class="product-info">
                        <div>
                            <h4 class="fw-bold mb-2">@product.Name</h4>
                            <h3 class="fw-bold text-price mb-3">@product.Price.ToString("C")</h3>
                        </div>
                        <a asp-controller="Customer" asp-action="Order" asp-route-productId="@product.RowKey" class="btn btn-rainbow w-100 mt-2">
                            <i class="bi bi-cart-plus-fill me-2"></i>Order Now
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
